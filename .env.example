# 아래 값들은 프로덕션 빌드(npm run build)에서만 적용됩니다. 로컬 개발 서버에서는 추적하지 않습니다.
# 값을 비워두면 해당 기능은 꺼집니다.

# Google Tag Manager 컨테이너 ID (권장). 설정하면 GA4는 GTM 안에서 연결합니다.
PUBLIC_GTM_ID=
# GTM 없이 GA4만 직접 붙일 때 사용 (GTM_ID가 있으면 무시됨)
PUBLIC_GA_ID=

# AdSense 게시자 ID (예: ca-pub-1234567890123456) — ads.txt도 자동 생성됩니다.
PUBLIC_ADSENSE_CLIENT=
# 글 하단 광고 단위의 슬롯 ID (AdSense > 광고 > 광고 단위에서 생성)
PUBLIC_ADSENSE_SLOT_POST_BOTTOM=

# 사이트 소유권 확인용 메타 태그 값
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_NAVER_SITE_VERIFICATION=
