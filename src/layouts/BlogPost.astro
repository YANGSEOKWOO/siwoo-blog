---
import 'katex/dist/katex.min.css';
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import AdSlot from '../components/AdSlot.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PostTerms from '../components/glossary/PostTerms.astro';
import PostTracking from '../components/PostTracking.astro';
import SeriesNav from '../components/SeriesNav.astro';
import { AUTHOR_NAME, CATEGORIES, SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { slug: string; headings: MarkdownHeading[]; body?: string };

const { title, description, category, pubDate, updatedDate, heroImage, tags, book, draft, series, slug, headings, body } = Astro.props;
const categoryInfo = CATEGORIES[category];
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: { '@type': 'Person', name: AUTHOR_NAME },
	publisher: { '@type': 'Organization', name: SITE_TITLE },
	mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
	articleSection: categoryInfo.label,
	keywords: tags.join(', '),
};
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={title} description={description} image={heroImage} type="article" jsonLd={jsonLd} />
	</head>

	<body>
		<Header category={category} />
		<div class="container layout">
			<article class="article">
				<header class="post-head">
					<p class="meta">
						<a href={`/${category}/`} class:list={['cat', category]}>{categoryInfo.label}</a>
						<FormattedDate date={pubDate} />
						{draft && <span class="draft">초안 · 배포되지 않음</span>}
						{
							updatedDate && (
								<span>
									(수정 <FormattedDate date={updatedDate} />)
								</span>
							)
						}
					</p>
					<h1>{title}</h1>
					<p class="lede">{description}</p>
					{
						book && (
							<dl class="book-info">
								<div>
									<dt>책</dt>
									<dd>{book.title}</dd>
								</div>
								<div>
									<dt>저자</dt>
									<dd>{book.author}</dd>
								</div>
								{book.publisher && (
									<div>
										<dt>출판</dt>
										<dd>
											{book.publisher}
											{book.year && ` (${book.year})`}
										</dd>
									</div>
								)}
							</dl>
						)
					}
					{
						tags.length > 0 && (
							<ul class="tags" aria-label="태그">
								{tags.map((t) => (
									<li>{t}</li>
								))}
							</ul>
						)
					}
				</header>

				{
					heroImage && (
						<Image class="hero" width={1440} height={720} src={heroImage} alt="" loading="eager" />
					)
				}

				{series && <SeriesNav id={series.id} current={slug} />}

				<div class="prose">
					<slot />
				</div>

				<PostTerms body={body} />

				<PostTracking slug={slug} tags={tags} category={category} />
				<AdSlot slot={import.meta.env.PUBLIC_ADSENSE_SLOT_POST_BOTTOM} />
			</article>

			{
				toc.length > 1 && (
					<aside class="toc" aria-label="목차">
						<p class="toc-title">목차</p>
						<ol>
							{toc.map((h) => (
								<li class={`d${h.depth}`}>
									<a href={`#${h.slug}`} data-slug={h.slug}>
										{h.text}
									</a>
								</li>
							))}
						</ol>
					</aside>
				)
			}
		</div>
		<Footer />

		<script>
			// ── 목차: 현재 읽는 섹션 표시 ──
			const links = new Map(
				[...document.querySelectorAll<HTMLAnchorElement>('.toc a')].map((a) => [a.dataset.slug!, a]),
			);
			if (links.size) {
				const heads = [...document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]')];
				const setActive = () => {
					let current = heads[0]?.id;
					for (const h of heads) if (h.getBoundingClientRect().top < 120) current = h.id;
					links.forEach((a, id) => a.toggleAttribute('aria-current', id === current));
				};
				addEventListener('scroll', setActive, { passive: true });
				setActive();
			}

			// ── Mermaid: 다이어그램이 있는 글에서만 로드, 테마 전환 시 다시 그림 ──
			const diagrams = [...document.querySelectorAll<HTMLElement>('pre.mermaid')];
			if (diagrams.length > 0) {
				diagrams.forEach((el) => (el.dataset.src = el.textContent ?? ''));
				const { default: mermaid } = await import('mermaid');
				const draw = async () => {
					const dark = document.documentElement.dataset.theme === 'dark';
					mermaid.initialize({
						startOnLoad: false,
						theme: dark ? 'dark' : 'neutral',
						fontFamily: 'Pretendard Variable, sans-serif',
					});
					diagrams.forEach((el) => {
						el.removeAttribute('data-processed');
						el.textContent = el.dataset.src ?? '';
					});
					await mermaid.run({ nodes: diagrams });
				};
				await draw();
				document.addEventListener('themechange', draw);
			}
		</script>
	</body>
</html>

<style>
	.layout {
		display: grid;
		grid-template-columns: minmax(0, 720px);
		justify-content: center;
		gap: 64px;
	}
	@media (min-width: 1140px) {
		.layout {
			grid-template-columns: minmax(0, 720px) 220px;
			max-width: 1100px;
		}
	}

	.post-head {
		padding: 3.5rem 0 2.5rem;
		border-bottom: 1px solid var(--line);
		margin-bottom: 2.5rem;
	}
	.meta {
		margin: 0 0 0.8rem;
		font-size: 0.88rem;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}
	.meta {
		display: flex;
		align-items: baseline;
		gap: 12px;
	}
	.cat {
		font-weight: 650;
		text-decoration: none;
	}
	.draft {
		color: var(--fail);
		font-weight: 600;
	}
	.cat.book {
		color: var(--ok);
	}
	.book-info {
		display: grid;
		gap: 4px;
		margin: 1.4rem 0 0;
		padding: 14px 18px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 10px;
		font-size: 0.93rem;
	}
	.book-info div {
		display: flex;
		gap: 14px;
	}
	.book-info dt {
		flex: 0 0 2.5em;
		color: var(--muted);
	}
	.book-info dd {
		margin: 0;
		color: var(--ink);
	}
	h1 {
		font-size: clamp(1.8rem, 4.2vw, 2.45rem);
		font-weight: 800;
		line-height: 1.3;
		letter-spacing: -0.035em;
	}
	.lede {
		margin: 1rem 0 0;
		font-size: 1.1rem;
		color: var(--muted);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		list-style: none;
		padding: 0;
		margin: 1.3rem 0 0;
	}
	.tags li {
		font-size: 0.8rem;
		color: var(--ink-soft);
		background: var(--code-inline-bg);
		padding: 2px 10px;
		border-radius: 999px;
	}
	.hero {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 12px;
		margin-bottom: 2.5rem;
	}

	/* 목차 */
	.toc {
		display: none;
	}
	@media (min-width: 1140px) {
		.toc {
			display: block;
			position: sticky;
			top: 96px;
			align-self: start;
			margin-top: 3.5rem;
			max-height: calc(100vh - 120px);
			overflow-y: auto;
			font-size: 0.86rem;
		}
	}
	.toc-title {
		margin: 0 0 0.75rem;
		font-weight: 650;
		color: var(--ink);
	}
	.toc ol {
		list-style: none;
		margin: 0;
		padding: 0 0 0 0;
		border-left: 1.5px solid var(--line);
	}
	.toc li {
		margin: 0;
	}
	.toc a {
		display: block;
		padding: 0.3rem 0 0.3rem 1rem;
		margin-left: -1.5px;
		border-left: 1.5px solid transparent;
		color: var(--muted);
		text-decoration: none;
		line-height: 1.5;
	}
	.toc .d3 a {
		padding-left: 1.9rem;
	}
	.toc a:hover {
		color: var(--ink);
	}
	.toc a[aria-current] {
		color: var(--accent);
		border-left-color: var(--accent);
		font-weight: 600;
	}
</style>
