---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import { AUTHOR_NAME, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedPosts } from '../lib/posts';

const all = await getPublishedPosts();
const recent = all.slice(0, 8);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="container narrow">
			<section class="intro">
				<h1>{AUTHOR_NAME}</h1>
				<p>{SITE_DESCRIPTION}</p>
			</section>

			<section aria-labelledby="recent-heading">
				<h2 id="recent-heading" class="section-title">최근 글</h2>
				<PostList posts={recent} animate />
				{all.length > recent.length && <a class="more" href="/blog/">글 {all.length}개 모두 보기</a>}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		padding: 4.5rem 0 3.5rem;
	}
	.intro h1 {
		font-size: clamp(1.9rem, 4.5vw, 2.6rem);
		font-weight: 800;
		letter-spacing: -0.035em;
	}
	.intro p {
		margin: 0.8rem 0 0;
		font-size: 1.08rem;
		color: var(--muted);
		max-width: 34em;
	}
	.section-title {
		font-size: 0.95rem;
		font-weight: 650;
		color: var(--muted);
		margin-bottom: 1.6rem;
	}
	.more {
		display: inline-block;
		margin-top: 2.5rem;
		font-weight: 600;
		text-decoration: none;
	}
</style>
