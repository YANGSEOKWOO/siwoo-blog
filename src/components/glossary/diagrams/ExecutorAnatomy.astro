---
/** ExecutorService 객체의 속: 힙에 있는 관리자 객체가 대기열과 일꾼 Thread 객체를 갖고, 일꾼마다 OS 스레드가 연결됨 */
const queued = ['T4', 'T5', 'T6', 'T7'];
const workers = [
	{ name: '일꾼 1', task: 'T1' },
	{ name: '일꾼 2', task: 'T2' },
	{ name: '일꾼 3', task: 'T3' },
];
---

<figure class="ana">
	<div class="caller">
		<p class="who">main 스레드 (내 코드)</p>
		<pre>executor.submit(T8)</pre>
		<p class="arrow">대기열에 넣고 바로 돌아옴 →</p>
	</div>

	<div class="heap">
		<p class="htitle">자바 힙 · ExecutorService 객체 <span>(실제로는 ThreadPoolExecutor)</span></p>

		<div class="part">
			<p class="plabel">① 대기열 <span>제출된 태스크가 줄 서는 곳</span></p>
			<div class="queue">
				{queued.map((t) => <span class="chip">{t}</span>)}
				<span class="chip new">T8</span>
			</div>
		</div>

		<div class="part">
			<p class="plabel">② 일꾼 목록 <span>Thread 객체 3개</span></p>
			<div class="workers">
				{workers.map((w) => <span class="wobj">{w.name}</span>)}
			</div>
		</div>
	</div>

	<div class="links" aria-hidden="true">
		{workers.map(() => <span>↓</span>)}
	</div>

	<div class="os">
		{
			workers.map((w) => (
				<div class="osth">
					<b>OS 스레드 + 스택</b>
					<span class="running">{w.task} 실행 중</span>
				</div>
			))
		}
	</div>

	<pre class="loop"><span class="c">// 일꾼마다 이 반복문을 돌고 있습니다 (단순화)</span>
while (true) {'{'}
    Runnable task = queue.take();  <span class="c">// 꺼냄 (비어 있으면 쉬며 기다림)</span>
    task.run();                    <span class="c">// 실행, 끝나면 다시 꺼내러 감</span>
{'}'}</pre>
</figure>

<style>
	.ana {
		display: grid;
		gap: 8px;
		margin: 0;
		padding: 14px 16px;
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: 12px;
	}
	pre {
		margin: 0;
		font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
		font-size: 0.74rem;
		line-height: 1.6;
		white-space: pre;
		overflow-x: auto;
	}
	.caller {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px 10px;
	}
	.who {
		margin: 0;
		font-size: 0.74rem;
		font-weight: 700;
		color: var(--ink);
	}
	.caller pre {
		padding: 2px 8px;
		color: var(--accent);
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 6px;
	}
	.arrow {
		margin: 0;
		font-size: 0.72rem;
		color: var(--muted);
	}
	.heap {
		padding: 10px 12px 12px;
		background: color-mix(in srgb, var(--accent) 6%, transparent);
		border: 1.5px solid var(--accent);
		border-radius: 10px;
	}
	.htitle {
		margin: 0 0 8px;
		font-size: 0.82rem;
		font-weight: 750;
		color: var(--ink);
	}
	.htitle span,
	.plabel span {
		font-size: 0.7rem;
		font-weight: 500;
		color: var(--muted);
	}
	.part + .part {
		margin-top: 8px;
	}
	.plabel {
		margin: 0 0 5px;
		font-size: 0.76rem;
		font-weight: 700;
		color: var(--ink-soft);
	}
	.queue {
		display: flex;
		flex-wrap: wrap;
		gap: 5px;
		padding: 7px;
		background: var(--surface);
		border: 1px dashed var(--line);
		border-radius: 8px;
	}
	.chip {
		padding: 1px 10px;
		font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
		font-size: 0.72rem;
		font-weight: 700;
		color: var(--accent);
		background: var(--accent-soft);
		border-radius: 999px;
	}
	.chip.new {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
	}
	.workers,
	.links,
	.os {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 6px;
	}
	.wobj {
		padding: 5px 8px;
		font-size: 0.76rem;
		font-weight: 650;
		text-align: center;
		color: var(--ink);
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 8px;
	}
	.links {
		margin: -4px 0;
		text-align: center;
		color: var(--ok);
		font-weight: 700;
	}
	.osth {
		padding: 6px 8px;
		text-align: center;
		background: var(--surface);
		border: 1px solid var(--line);
		border-top: 3px solid var(--ok);
		border-radius: 8px;
	}
	.osth b {
		display: block;
		font-size: 0.72rem;
		color: var(--ink);
	}
	.running {
		display: inline-block;
		margin-top: 4px;
		padding: 1px 8px;
		font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 700;
		color: var(--surface);
		background: var(--accent);
		border-radius: 999px;
	}
	.loop {
		margin-top: 4px;
		padding: 10px 12px;
		color: var(--ink);
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 8px;
	}
	.loop .c {
		color: var(--muted);
	}
	@media (max-width: 720px) {
		.ana {
			padding: 12px;
		}
		.osth b {
			font-size: 0.66rem;
		}
	}
</style>
