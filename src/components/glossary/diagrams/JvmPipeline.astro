---
/** C와 자바가 여러 OS에서 실행되는 방식 비교. 자바는 바이트코드 하나를 OS마다 있는 JVM이 실행합니다. */
const oses = ['윈도우', '맥', '리눅스'];
---

<figure class="pipe">
	<div class="panel">
		<p class="ptitle">C 언어</p>
		<div class="box src">hello.c</div>
		<p class="arrow">OS마다 따로 컴파일</p>
		<div class="trio">{oses.map((os) => <div class="box bin">{os}용 기계어</div>)}</div>
		<p class="arrow"></p>
		<div class="trio">{oses.map((os) => <div class="box os">{os}</div>)}</div>
		<p class="note">컴파일 결과를 다른 OS로 가져가면 실행되지 않습니다.</p>
	</div>

	<div class="panel java">
		<p class="ptitle">자바</p>
		<div class="box src">Hello.java</div>
		<p class="arrow">javac로 <b>한 번만</b> 컴파일</p>
		<div class="box byte">Hello.class<small>바이트코드 · 어디서나 같은 파일</small></div>
		<p class="arrow">같은 파일을 그대로 가져감</p>
		<div class="trio">{oses.map((os) => <div class="box jvm">{os}용 JVM</div>)}</div>
		<p class="arrow">각 JVM이 자기 OS에 맞게 실행</p>
		<div class="trio">{oses.map((os) => <div class="box os">{os}</div>)}</div>
		<p class="note">Write once, run anywhere</p>
	</div>
</figure>

<style>
	.pipe {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
		gap: 12px;
		margin: 0;
	}
	.panel {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		padding: 14px 14px 12px;
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: 12px;
		text-align: center;
	}
	.panel.java {
		border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
	}
	.ptitle {
		margin: 0 0 10px;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--ink);
		text-align: left;
	}
	.box {
		padding: 7px 8px;
		font-size: 0.8rem;
		font-weight: 600;
		line-height: 1.4;
		color: var(--ink);
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 8px;
	}
	.box small {
		display: block;
		font-size: 0.7rem;
		font-weight: 500;
		color: var(--muted);
	}
	.src {
		font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
		font-size: 0.78rem;
	}
	.byte {
		color: var(--accent);
		background: var(--accent-soft);
		border-color: color-mix(in srgb, var(--accent) 40%, transparent);
		font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
	}
	.jvm {
		color: var(--ok);
		background: color-mix(in srgb, var(--ok) 12%, transparent);
		border-color: color-mix(in srgb, var(--ok) 40%, transparent);
	}
	.bin {
		color: var(--ink-soft);
		background: var(--code-inline-bg);
	}
	.os {
		font-weight: 500;
		color: var(--muted);
		border-style: dashed;
	}
	.trio {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 6px;
	}
	.arrow {
		margin: 4px 0;
		font-size: 0.72rem;
		color: var(--muted);
	}
	.arrow::before {
		content: '↓ ';
	}
	.note {
		margin: 10px 0 0;
		font-size: 0.74rem;
		color: var(--muted);
	}
	.java .note {
		font-weight: 650;
		color: var(--accent);
	}
	@media (max-width: 720px) {
		.pipe {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
