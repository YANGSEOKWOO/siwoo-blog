---
/**
 * 글 하단의 "이 글에 나온 용어" 상자. 본문에서 <Term>으로 쓴 용어를 자동으로 모읍니다.
 * BlogPost 레이아웃이 넣어 주므로 글에서 따로 쓸 필요는 없습니다.
 */
import { extractTermIds, getTerm, termHref } from '../../lib/glossary';

interface Props {
	body?: string;
}
const ids = extractTermIds(Astro.props.body);
const terms = await Promise.all(ids.map(getTerm));
---

{
	terms.length > 0 && (
		<aside class="post-terms" aria-label="이 글에 나온 용어">
			<p class="title">이 글에 나온 용어</p>
			<dl>
				{terms.map((t) => (
					<div>
						<dt>
							<a href={termHref(t.id)}>{t.data.term}</a>
						</dt>
						<dd>{t.data.summary}</dd>
					</div>
				))}
			</dl>
		</aside>
	)
}

<style>
	.post-terms {
		margin-top: 3.5rem;
		padding: 20px 22px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 14px;
	}
	.title {
		margin: 0 0 12px;
		font-weight: 700;
		color: var(--ink);
	}
	dl {
		display: grid;
		gap: 10px;
		margin: 0;
	}
	dl div {
		display: grid;
		grid-template-columns: 9em 1fr;
		gap: 14px;
		font-size: 0.92rem;
		line-height: 1.6;
	}
	dt a {
		font-weight: 650;
		text-decoration: none;
	}
	dd {
		margin: 0;
		color: var(--muted);
	}
	@media (max-width: 720px) {
		dl div {
			grid-template-columns: 1fr;
			gap: 0;
		}
	}
</style>
