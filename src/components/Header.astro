---
import { CATEGORIES, GITHUB_URL, SITE_TITLE, type Category } from '../consts';

interface Props {
	/** 글 페이지에서 해당 글의 카테고리 메뉴를 활성화하기 위해 넘깁니다. */
	category?: Category;
}
const { category } = Astro.props;
const path = Astro.url.pathname;
const links = [
	{ href: '/tech/', label: CATEGORIES.tech.label, active: path.startsWith('/tech') || category === 'tech' },
	{ href: '/book/', label: CATEGORIES.book.label, active: path.startsWith('/book') || category === 'book' },
	{ href: '/about/', label: '소개', active: path.startsWith('/about') },
];
---

<header class="site-header">
	<div class="container bar">
		<a href="/" class="wordmark">{SITE_TITLE}</a>
		<nav aria-label="주요 메뉴">
			{
				links.map((l) => (
					<a href={l.href} aria-current={l.active ? 'page' : undefined}>
						{l.label}
					</a>
				))
			}
			<a href={GITHUB_URL} target="_blank" rel="noopener" class="gh">GitHub</a>
			<button type="button" class="theme-toggle" aria-label="다크 모드 전환">
				<svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
					<path fill="currentColor" d="M20.7 14.6A8.5 8.5 0 0 1 9.4 3.3a.6.6 0 0 0-.8-.7A9.7 9.7 0 1 0 21.4 15.4a.6.6 0 0 0-.7-.8Z"></path>
				</svg>
				<svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
					<g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
						<path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
					</g>
				</svg>
			</button>
		</nav>
	</div>
</header>

<script>
	document.querySelector('.theme-toggle')?.addEventListener('click', () => {
		const root = document.documentElement;
		const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
		root.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {}
		document.dispatchEvent(new CustomEvent('themechange', { detail: next }));
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--line);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 60px;
	}
	.wordmark {
		color: var(--ink);
		font-weight: 750;
		font-size: 1.02rem;
		letter-spacing: -0.03em;
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 4px;
	}
	nav a {
		color: var(--muted);
		text-decoration: none;
		font-size: 0.94rem;
		padding: 6px 10px;
		border-radius: 8px;
	}
	nav a:hover {
		color: var(--ink);
	}
	nav a[aria-current='page'] {
		color: var(--ink);
		font-weight: 650;
	}
	.theme-toggle {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		margin-left: 4px;
		border: 0;
		border-radius: 8px;
		background: transparent;
		color: var(--muted);
		cursor: pointer;
	}
	.theme-toggle:hover {
		color: var(--ink);
		background: var(--line);
	}
	@media (max-width: 480px) {
		.gh {
			display: none;
		}
		nav a {
			padding: 6px 8px;
		}
	}
	:global([data-theme='dark']) .icon-moon,
	:global([data-theme='light']) .icon-sun {
		display: none;
	}
</style>
