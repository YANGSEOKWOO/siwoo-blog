---
/**
 * 글 목록을 "요청 트레이스"처럼 그립니다: 왼쪽 세로선 위에 글마다 노드가 있고,
 * animate=true면 페이지를 처음 열 때 패킷 하나가 선을 따라 한 번 내려갑니다.
 */
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES } from '../consts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
	animate?: boolean;
	/** 날짜 아래에 카테고리(기술/책) 표시. 카테고리 페이지에서는 끕니다. */
	showCategory?: boolean;
}
const { posts, animate = false, showCategory = true } = Astro.props;
---

{
	posts.length === 0 ? (
		<p class="empty">첫 글을 준비하고 있습니다.</p>
	) : (
		<ol class:list={['trace', { animate }]}>
			{posts.map((post) => (
				<li>
					<div class="when">
						<FormattedDate date={post.data.pubDate} />
						{showCategory && (
							<span class:list={['cat', post.data.category]}>{CATEGORIES[post.data.category].label}</span>
						)}
					</div>
					<span class="node" aria-hidden="true" />
					<a href={`/blog/${post.id}/`} class="entry">
						<h3>
							{post.data.draft && <span class="draft">초안</span>}
							{post.data.title}
						</h3>
						<p class="desc">{post.data.description}</p>
						{post.data.tags.length > 0 && (
							<ul class="tags" aria-label="태그">
								{post.data.tags.map((t) => (
									<li>{t}</li>
								))}
							</ul>
						)}
					</a>
				</li>
			))}
			{animate && <span class="packet" aria-hidden="true" />}
		</ol>
	)
}

<style>
	.trace {
		--date-col: 112px;
		--rail-x: calc(var(--date-col) + 20px);
		position: relative;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	/* 세로 레일 */
	.trace::before {
		content: '';
		position: absolute;
		left: var(--rail-x);
		top: 14px;
		bottom: 14px;
		width: 1.5px;
		background: var(--line);
	}
	.trace > li {
		position: relative;
		display: grid;
		grid-template-columns: var(--date-col) 40px 1fr;
		align-items: start;
		padding: 0 0 2.4rem;
	}
	.trace > li:last-of-type {
		padding-bottom: 0;
	}
	.when {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		padding-top: 3px;
		font-size: 0.86rem;
		line-height: 1.5;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.cat {
		margin-top: 2px;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--accent);
	}
	.cat.book {
		color: var(--ok);
	}
	.node {
		justify-self: center;
		margin-top: 10px;
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: var(--bg);
		border: 2px solid var(--muted);
		position: relative;
		z-index: 1;
		transition: border-color 0.15s, background-color 0.15s;
	}
	li:hover .node,
	li:focus-within .node {
		border-color: var(--accent);
		background: var(--accent);
	}
	.entry {
		display: block;
		min-width: 0;
		text-decoration: none;
		color: inherit;
		border-radius: 6px;
	}
	h3 {
		font-size: 1.22rem;
		font-weight: 700;
		line-height: 1.4;
	}
	.draft {
		display: inline-block;
		margin-right: 8px;
		padding: 0 7px;
		border: 1px dashed var(--fail);
		border-radius: 6px;
		color: var(--fail);
		font-size: 0.75rem;
		font-weight: 600;
		vertical-align: 3px;
	}
	.entry:hover h3 {
		color: var(--accent);
	}
	.desc {
		margin: 0.3rem 0 0;
		color: var(--muted);
		font-size: 0.97rem;
		line-height: 1.65;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		list-style: none;
		padding: 0;
		margin: 0.7rem 0 0;
	}
	.tags li {
		font-size: 0.78rem;
		color: var(--ink-soft);
		background: var(--code-inline-bg);
		padding: 1px 8px;
		border-radius: 999px;
	}

	/* 페이지 로드 시 패킷이 레일을 따라 한 번 내려감 — 사이트의 유일한 자동 모션 */
	.packet {
		position: absolute;
		left: calc(var(--rail-x) - 3.75px);
		top: 10px;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 4px var(--accent-soft);
		z-index: 2;
		opacity: 0;
		animation: travel 2.4s cubic-bezier(0.55, 0.05, 0.35, 1) 0.3s 1 forwards;
	}
	@keyframes travel {
		0% {
			top: 10px;
			opacity: 0;
		}
		8% {
			opacity: 1;
		}
		88% {
			opacity: 1;
		}
		100% {
			top: calc(100% - 20px);
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.packet {
			display: none;
		}
	}

	.empty {
		color: var(--muted);
	}

	@media (max-width: 640px) {
		.trace {
			--rail-x: 5px;
		}
		.trace > li {
			grid-template-columns: 22px 1fr;
			grid-template-areas:
				'node date'
				'. entry';
			padding-bottom: 2rem;
		}
		.node {
			grid-area: node;
			justify-self: start;
			margin-top: 7px;
		}
		.when {
			grid-area: date;
			flex-direction: row;
			align-items: baseline;
			gap: 10px;
			padding-top: 0;
		}
		.cat {
			margin-top: 0;
		}
		.entry {
			grid-area: entry;
			margin-top: 2px;
		}
		.packet {
			left: 1.25px;
		}
	}
</style>
