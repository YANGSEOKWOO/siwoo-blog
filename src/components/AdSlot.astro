---
/**
 * AdSense 수동 광고 단위.
 * 클라이언트 ID나 슬롯 ID가 없거나 개발 모드면 아무것도 렌더링하지 않습니다.
 * min-height로 자리를 미리 잡아서 광고가 늦게 떠도 레이아웃이 밀리지 않게(CLS 방지) 합니다.
 */
interface Props {
	slot?: string;
	minHeight?: number;
}
const { slot, minHeight = 280 } = Astro.props;
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const enabled = import.meta.env.PROD && client && slot;
---

{
	enabled && (
		<aside class="ad-slot" style={`min-height:${minHeight}px`} aria-label="광고">
			<ins
				class="adsbygoogle"
				style="display:block"
				data-ad-client={client}
				data-ad-slot={slot}
				data-ad-format="auto"
				data-full-width-responsive="true"
			/>
			<script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
		</aside>
	)
}

<style>
	.ad-slot {
		margin: 2.5em 0;
	}
</style>
