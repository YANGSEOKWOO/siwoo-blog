---
/**
 * 글 페이지 전용 커스텀 이벤트.
 * - code_copy: 코드 블록 복사 버튼 클릭 (어떤 글/언어가 "실제로 쓰였는지" 보여주는 지표)
 * - read_complete: 본문 끝까지 도달 (GA4 기본 scroll 90%보다 정확한 완독 신호)
 * GTM을 쓰면 GTM에서 "맞춤 이벤트" 트리거로 GA4 이벤트 태그를 연결하세요 (README 참고).
 */
interface Props {
	slug: string;
	tags: string[];
	category: string;
}
const { slug, tags, category } = Astro.props;
---

<div id="post-tracking" data-slug={slug} data-tags={tags.join(',')} data-category={category} hidden></div>
<div id="read-complete-sentinel" aria-hidden="true"></div>

<script>
	type Track = (name: string, params?: Record<string, unknown>) => void;
	const track: Track = (name, params) => (window as unknown as { track?: Track }).track?.(name, params);

	const meta = document.getElementById('post-tracking');
	const base = {
		post_slug: meta?.dataset.slug ?? '',
		post_tags: meta?.dataset.tags ?? '',
		post_category: meta?.dataset.category ?? '',
	};

	// 코드 복사 (expressive-code의 복사 버튼)
	document.addEventListener('click', (e) => {
		const btn = (e.target as Element | null)?.closest('.expressive-code .copy button');
		if (!btn) return;
		const pre = btn.closest('.expressive-code')?.querySelector('pre');
		track('code_copy', { ...base, code_language: pre?.dataset.language ?? 'unknown' });
	});

	// 완독
	const sentinel = document.getElementById('read-complete-sentinel');
	if (sentinel && 'IntersectionObserver' in window) {
		const started = performance.now();
		const io = new IntersectionObserver((entries) => {
			if (!entries.some((en) => en.isIntersecting)) return;
			io.disconnect();
			track('read_complete', {
				...base,
				seconds_to_complete: Math.round((performance.now() - started) / 1000),
			});
		});
		io.observe(sentinel);
	}
</script>
