---
/**
 * Flask의 세 겹 라이프사이클을 보여주는 그림.
 * 위: 워커 프로세스(애플리케이션) 타임라인 위에 요청마다 앱 컨텍스트 ⊃ 요청 컨텍스트가 열리고 닫힘.
 *     비교용으로 Spring Boot의 오래 사는 Bean 막대를 한 줄 함께 둠.
 * 아래: 요청 하나를 확대해서 컨텍스트가 열리고 닫히는 순서와 훅을 보여줌.
 */
interface Props {
	caption?: string;
}
const { caption } = Astro.props;

// 타임라인 위 요청 블록 위치 (% 단위)
const workers = [
	{ name: '워커 #1', reqs: [{ l: 8, w: 13 }, { l: 34, w: 18, focus: true }, { l: 70, w: 11 }] },
	{ name: '워커 #2', reqs: [{ l: 18, w: 16 }, { l: 56, w: 14 }, { l: 82, w: 9 }] },
];
const hooks = ['before_request', 'view 함수', 'after_request', 'teardown_request'];
---

<figure class="flayers">
	<div class="board">
		<ul class="legend" aria-label="범례">
			<li><i class="sw app"></i>애플리케이션 (워커 프로세스)</li>
			<li><i class="sw actx"></i>앱 컨텍스트</li>
			<li><i class="sw rctx"></i>요청 컨텍스트</li>
		</ul>

		<div class="timeline">
			<div class="axis" aria-hidden="true">
				<span>import · 앱 생성</span>
				<span class="arrow"></span>
				<span>종료</span>
			</div>

			{workers.map((wk) => (
				<div class="lane">
					<p class="lane-name">{wk.name}<small>Flask</small></p>
					<div class="track">
						<span class="app-bar"></span>
						{wk.reqs.map((r, i) => (
							<span class={`req${r.focus ? ' focus' : ''}`} style={`left:${r.l}%;width:${r.w}%;--d:${i}`}>
								<span class="inner"></span>
								{r.focus && <span class="zoom-tag">확대 ↓</span>}
							</span>
						))}
					</div>
				</div>
			))}

			<div class="lane spring">
				<p class="lane-name">비교<small>Spring Boot</small></p>
				<div class="track">
					<span class="app-bar"></span>
					<span class="bean-bar">Bean: 서버와 함께 오래 삶</span>
				</div>
			</div>
		</div>

		<div class="zoom">
			<p class="zoom-title">요청 하나를 확대하면</p>
			<div class="z-app">
				<span class="z-label">앱 컨텍스트 <code>g</code></span>
				<span class="evt">열림</span>
				<div class="z-req">
					<span class="z-label">요청 컨텍스트 <code>request</code></span>
					<span class="evt">열림</span>
					<ol class="hooks">
						{hooks.map((h, i) => (
							<li class={h === 'view 함수' ? 'view' : ''}><small>{i + 1}</small>{h}</li>
						))}
					</ol>
					<span class="evt">닫힘</span>
				</div>
				<span class="evt hook-out"><code>teardown_appcontext</code></span>
				<span class="evt">닫힘</span>
			</div>
			<p class="note">이름은 “앱” 컨텍스트지만, 요청마다 열리고 닫힙니다. 서버와 함께 오래 사는 층은 애플리케이션 하나뿐입니다.</p>
		</div>
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.flayers {
		--app: var(--accent);
		--actx: #0e8f86;
		--rctx: #c27303;
		--bean: var(--ok);
		margin: 2.2em 0;
	}
	.board {
		padding: 22px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 14px;
		display: grid;
		gap: 22px;
	}
	.legend {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 6px 18px;
		font-size: 0.78rem;
		color: var(--muted);
	}
	.legend li { display: inline-flex; align-items: center; gap: 6px; }
	.sw { width: 14px; height: 10px; border-radius: 3px; display: inline-block; }
	.sw.app { background: color-mix(in srgb, var(--app) 22%, transparent); border: 1px solid var(--app); }
	.sw.actx { border: 1.5px solid var(--actx); background: color-mix(in srgb, var(--actx) 12%, transparent); }
	.sw.rctx { background: var(--rctx); }

	/* ── timeline ── */
	.timeline { display: grid; gap: 10px; }
	.axis {
		margin-left: 92px;
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 0.7rem;
		color: var(--muted);
		white-space: nowrap;
	}
	.arrow { flex: 1; height: 1px; background: var(--line); position: relative; }
	.arrow::after {
		content: '';
		position: absolute;
		right: -1px;
		top: -4px;
		border: 4px solid transparent;
		border-left: 7px solid var(--line);
		border-right: none;
	}
	.lane { display: grid; grid-template-columns: 82px minmax(0, 1fr); gap: 10px; align-items: center; }
	.lane-name { margin: 0; font-size: 0.82rem; font-weight: 700; display: grid; line-height: 1.3; }
	.lane-name small { font-weight: 400; font-size: 0.68rem; color: var(--muted); }
	.track { position: relative; height: 46px; }
	.app-bar {
		position: absolute;
		inset: 8px 0;
		border-radius: 8px;
		background: color-mix(in srgb, var(--app) 12%, transparent);
		border: 1px solid color-mix(in srgb, var(--app) 40%, transparent);
	}
	.req {
		position: absolute;
		top: 2px;
		bottom: 2px;
		border-radius: 8px;
		border: 1.5px solid var(--actx);
		background: color-mix(in srgb, var(--actx) 14%, var(--surface));
		padding: 5px;
		animation: pop 0.5s ease-out both;
		animation-delay: calc(var(--d) * 0.15s);
	}
	.req .inner {
		display: block;
		height: 100%;
		border-radius: 5px;
		background: var(--rctx);
		opacity: 0.85;
	}
	.req.focus {
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--rctx) 30%, transparent);
	}
	.zoom-tag {
		position: absolute;
		left: 50%;
		bottom: -18px;
		transform: translateX(-50%);
		font-size: 0.66rem;
		font-weight: 700;
		color: var(--rctx);
		white-space: nowrap;
	}
	.lane.spring { margin-top: 6px; padding-top: 12px; border-top: 1px dashed var(--line); }
	.bean-bar {
		position: absolute;
		inset: 12px 4px;
		border-radius: 6px;
		background: color-mix(in srgb, var(--bean) 30%, transparent);
		border: 1px solid var(--bean);
		font-size: 0.7rem;
		display: flex;
		align-items: center;
		padding: 0 10px;
		white-space: nowrap;
		overflow: hidden;
	}
	@keyframes pop {
		from { transform: scale(0.85); opacity: 0.4; }
		to { transform: scale(1); opacity: 1; }
	}

	/* ── zoom ── */
	.zoom {
		display: grid;
		gap: 10px;
		padding: 16px;
		border-radius: 12px;
		background: color-mix(in srgb, var(--rctx) 5%, transparent);
		border: 1px solid color-mix(in srgb, var(--rctx) 25%, transparent);
	}
	.zoom-title { margin: 0; font-size: 0.8rem; font-weight: 700; color: var(--rctx); }
	.z-app, .z-req {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		border-radius: 10px;
		padding: 28px 12px 12px;
	}
	.z-app {
		border: 1.5px solid var(--actx);
		background: color-mix(in srgb, var(--actx) 8%, var(--surface));
	}
	.z-req {
		flex: 1 1 360px;
		border: 1.5px solid var(--rctx);
		background: color-mix(in srgb, var(--rctx) 9%, var(--surface));
	}
	.z-label {
		position: absolute;
		top: 6px;
		left: 12px;
		font-size: 0.74rem;
		font-weight: 700;
	}
	.z-app > .z-label { color: var(--actx); }
	.z-req > .z-label { color: var(--rctx); }
	.z-label code { font-size: 0.7rem; font-weight: 400; margin-left: 4px; }
	.evt {
		font-size: 0.7rem;
		color: var(--muted);
		border: 1px dashed var(--line);
		border-radius: 999px;
		padding: 1px 8px;
		background: var(--surface);
	}
	.evt.hook-out { border-style: solid; border-color: var(--actx); color: var(--ink); }
	.evt code { font-size: 0.7rem; }
	.hooks {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		align-items: center;
	}
	.hooks li {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-size: 0.76rem;
		font-family: var(--font-mono, ui-monospace, monospace);
		background: var(--surface);
		border: 1px solid color-mix(in srgb, var(--rctx) 40%, transparent);
		border-radius: 6px;
		padding: 3px 8px;
	}
	.hooks li + li::before {
		content: '→';
		margin-right: 4px;
		color: var(--muted);
		font-family: inherit;
	}
	.hooks li.view {
		background: var(--rctx);
		border-color: var(--rctx);
		color: #fff;
		font-weight: 700;
	}
	.hooks small { font-size: 0.62rem; opacity: 0.7; }
	.note { margin: 0; font-size: 0.78rem; color: var(--muted); }

	figcaption { margin-top: 0.7em; text-align: center; font-size: 0.85rem; color: var(--muted); }

	@media (max-width: 640px) {
		.board { padding: 14px; }
		.axis { margin-left: 0; }
		.lane { grid-template-columns: minmax(0, 1fr); gap: 4px; }
		.lane-name { display: flex; gap: 6px; align-items: baseline; }
		.bean-bar { font-size: 0.62rem; }
		.z-app, .z-req { padding: 26px 8px 8px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.req { animation: none; }
	}
</style>
