---
/**
 * Spring Boot "준비" 시기를 큰 흐름(java -jar → … → 요청 받을 준비 끝)으로 보여주고,
 * 각 단계에 등장하는 세부 개념(@Component, Bean, DI, 훅 등)을 작은 카드로 붙인 그림.
 * 큰 흐름이 먼저 읽히고, 세부 개념은 "이 단계에서 나오는 말"로만 보이도록 작게 둡니다.
 */
interface Concept {
	term: string;
	note: string;
}
interface Stage {
	title: string;
	sub: string;
	concepts?: Concept[];
}
interface Props {
	caption?: string;
	stages?: Stage[];
}
const defaultStages: Stage[] = [
	{
		title: '프로세스 시작',
		sub: 'java -jar app.jar → main() 실행',
		concepts: [{ term: 'JVM', note: 'OS가 실제로 실행하는 프로그램' }],
	},
	{
		title: '이름표 찾기',
		sub: '기준 패키지 아래 클래스를 훑음',
		concepts: [
			{ term: '@Component', note: '“이 클래스는 미리 만들어 둬”라는 이름표' },
			{ term: '컴포넌트 스캔', note: '이름표를 찾아다니는 과정' },
		],
	},
	{
		title: '객체 만들고 연결',
		sub: '찾은 클래스로 객체를 만들어 보관',
		concepts: [
			{ term: 'Bean', note: '스프링이 만들어 보관하는 객체' },
			{ term: 'DI', note: '필요한 Bean을 생성자로 넣어 줌' },
			{ term: 'ApplicationContext', note: 'Bean 보관함' },
		],
	},
	{
		title: '준비 작업 실행',
		sub: '정해진 시점에 내 코드를 불러 줌',
		concepts: [{ term: '훅', note: '@PostConstruct, Runner 같은 끼어드는 자리' }],
	},
	{
		title: '문 열기',
		sub: '8080 포트 listen → 요청 대기',
		concepts: [{ term: '내장 톰캣', note: '요청을 받아 스레드에 넘기는 서버' }],
	},
];
const { caption, stages = defaultStages } = Astro.props;
---

<figure class="sflow">
	<div class="board">
		<p class="phase-tag">준비 <small>서버 켤 때 1번</small></p>
		<ol class="track">
			{stages.map((s, i) => (
				<li class="stage">
					<span class="idx">{i + 1}</span>
					<p class="t">{s.title}</p>
					<p class="sub">{s.sub}</p>
					{s.concepts && (
						<ul class="concepts">
							{s.concepts.map((c) => (
								<li><b>{c.term}</b><span>{c.note}</span></li>
							))}
						</ul>
					)}
				</li>
			))}
		</ol>
		<p class="next">→ 영업 시작: 요청이 오면 만들어 둔 Bean들이 처리</p>
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.sflow { margin: 2.2em 0; }
	.board {
		padding: 20px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 14px;
		display: grid;
		gap: 14px;
	}
	.phase-tag { margin: 0; font-weight: 700; color: var(--accent); }
	.phase-tag small { font-weight: 400; color: var(--muted); margin-left: 6px; font-size: 0.8rem; }
	.track {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 10px;
		position: relative;
	}
	.stage {
		position: relative;
		display: grid;
		gap: 4px;
		align-content: start;
		padding: 12px 10px 10px;
		border-radius: 10px;
		background: var(--accent-soft);
		border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
	}
	.stage + .stage::before {
		content: '→';
		position: absolute;
		left: -10px;
		top: 14px;
		width: 10px;
		text-align: center;
		color: var(--muted);
		font-size: 0.8rem;
	}
	.idx {
		font-size: 0.7rem;
		font-weight: 700;
		color: var(--accent);
	}
	.t { margin: 0; font-weight: 700; font-size: 0.95rem; line-height: 1.35; }
	.sub { margin: 0; font-size: 0.78rem; color: var(--muted); line-height: 1.45; }
	.concepts {
		list-style: none;
		margin: 6px 0 0;
		padding: 6px 0 0;
		border-top: 1px dashed color-mix(in srgb, var(--accent) 35%, transparent);
		display: grid;
		gap: 5px;
	}
	.concepts li {
		display: grid;
		gap: 0;
		font-size: 0.72rem;
		line-height: 1.4;
		background: var(--surface);
		border-radius: 6px;
		padding: 4px 7px;
	}
	.concepts b { font-size: 0.74rem; color: var(--ink); }
	.concepts span { color: var(--muted); }
	.next {
		margin: 0;
		font-size: 0.85rem;
		color: var(--muted);
		text-align: right;
	}
	figcaption { margin-top: 0.7em; text-align: center; font-size: 0.85rem; color: var(--muted); }
	@media (max-width: 760px) {
		.track { grid-template-columns: minmax(0, 1fr); gap: 14px; }
		.stage + .stage::before { content: '↓'; left: 50%; top: -14px; width: auto; transform: translateX(-50%); }
		.next { text-align: left; }
	}
</style>
