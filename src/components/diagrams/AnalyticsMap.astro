---
/**
 * Search Console · GTM · GA4가 사용자 여정의 어느 구간을 맡는지 보여주는 그림.
 * 위: 방문 전(검색 결과) → 클릭 → 방문 후(블로그) / 아래: 각 구간을 측정하는 도구.
 * 넓은 화면에서는 좌우 2단, 좁은 화면에서는 세로로 쌓입니다.
 */
interface Props {
	postTitle?: string;
	domain?: string;
	caption?: string;
}
const {
	postTitle = 'GA4, GTM을 통해 측정가능한 지표 구축하기',
	domain = 'siwoo-blog-nine.vercel.app',
	caption,
} = Astro.props;
---

<figure class="amap">
	<div class="board">
		<!-- 방문 전 -->
		<section class="phase before" aria-label="방문 전">
			<p class="phase-name">방문 전</p>
			<div class="mock search" aria-hidden="true">
				<div class="searchbar"><span class="q">gtm ga4 차이</span></div>
				<div class="result">
					<p class="r-url">{domain} › blog</p>
					<p class="r-title">{postTitle}</p>
					<span class="bar w90"></span>
					<span class="bar w70"></span>
				</div>
				<div class="result dim">
					<span class="bar w40 t"></span>
					<span class="bar w80"></span>
				</div>
			</div>
			<p class="stage-steps"><span>노출</span><i>→</i><span>클릭</span></p>
		</section>

		<div class="hop click" aria-hidden="true">
			<span class="hop-line"></span>
			<span class="hop-label">클릭해서 들어옴</span>
		</div>

		<!-- 방문 후 -->
		<section class="phase after" aria-label="방문 후">
			<p class="phase-name">방문 후</p>
			<div class="mock browser" aria-hidden="true">
				<div class="chrome">
					<span class="dot"></span><span class="dot"></span><span class="dot"></span>
					<span class="addr">{domain}/blog/…</span>
				</div>
				<div class="page">
					<span class="bar w60 t"></span>
					<span class="bar w95"></span>
					<span class="bar w85"></span>
					<span class="bar w90"></span>
					<span class="code"></span>
					<span class="bar w75"></span>
				</div>
			</div>
			<p class="stage-steps"><span>도착</span><i>→</i><span>읽기·스크롤</span><i>→</i><span>이탈</span></p>
		</section>

		<!-- 아래로 내려가는 연결 -->
		<div class="drop drop-sc" aria-hidden="true"><span>검색 기록</span></div>
		<div class="drop drop-ga" aria-hidden="true">
			<span class="gtm-pipe">
				<b>GTM</b>
				<small>Google 태그를 실행해 기록 전송</small>
			</span>
		</div>

		<!-- 도구 카드 -->
		<article class="tool sc">
			<header>
				<h4>Search Console</h4>
				<span class="badge">사이트 코드 없이 동작</span>
			</header>
			<p class="what">구글 검색에서 내 글이 몇 번 보였고, 몇 번 클릭됐는지</p>
			<dl>
				<dt>데이터 출처</dt>
				<dd>구글 검색 엔진이 가진 기록</dd>
			</dl>
			<ul class="chips">
				<li>노출수</li><li>클릭수</li><li>CTR</li><li>평균 순위</li><li>검색어</li>
			</ul>
		</article>

		<div class="link" role="note">
			<span class="link-line" aria-hidden="true"></span>
			<span class="link-label">GA4에서 연결하면<br />방문 전·후를 이어서 분석</span>
		</div>

		<article class="tool ga">
			<header>
				<h4>GA4</h4>
				<span class="badge">Google 태그 필요</span>
			</header>
			<p class="what">들어온 사람이 사이트 안에서 무엇을 했는지</p>
			<dl>
				<dt>데이터 출처</dt>
				<dd>방문자 브라우저가 보내는 기록</dd>
			</dl>
			<ul class="chips">
				<li>사용자</li><li>세션</li><li>참여율</li><li>스크롤</li><li>이벤트</li>
			</ul>
		</article>
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.amap {
		--sc: var(--ok);
		--ga: var(--accent);
		--card: var(--surface);
		margin: 2.2em 0;
	}
	.board {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 96px minmax(0, 1fr);
		grid-template-areas:
			'before click after'
			'dsc    .     dga'
			'sc     link  ga';
		align-items: stretch;
		padding: 22px;
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: 14px;
	}

	/* ── 단계 (방문 전 / 방문 후) ── */
	.phase {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.before {
		grid-area: before;
	}
	.after {
		grid-area: after;
	}
	.phase-name {
		margin: 0;
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--muted);
	}
	.stage-steps {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px;
		font-size: 0.8rem;
		color: var(--ink-soft);
	}
	.stage-steps span {
		padding: 1px 8px;
		border-radius: 999px;
		background: var(--code-inline-bg);
	}
	.stage-steps i {
		font-style: normal;
		color: var(--muted);
	}

	/* ── 화면 목업 ── */
	.mock {
		flex: 1;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--bg);
		overflow: hidden;
		min-height: 150px;
	}
	.bar {
		display: block;
		height: 6px;
		border-radius: 3px;
		background: var(--line);
		margin-top: 6px;
	}
	.bar.t {
		height: 8px;
		background: color-mix(in srgb, var(--ink) 25%, var(--line));
	}
	.w40 { width: 40%; }
	.w60 { width: 60%; }
	.w70 { width: 70%; }
	.w75 { width: 75%; }
	.w80 { width: 80%; }
	.w85 { width: 85%; }
	.w90 { width: 90%; }
	.w95 { width: 95%; }

	.search {
		padding: 12px;
	}
	.searchbar {
		display: flex;
		align-items: center;
		height: 28px;
		padding: 0 12px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--card);
		font-size: 0.75rem;
		color: var(--ink-soft);
	}
	.result {
		margin-top: 12px;
		padding: 10px 12px;
		border-radius: 8px;
		background: var(--card);
		border: 1.5px solid color-mix(in srgb, var(--sc) 55%, transparent);
	}
	.result.dim {
		border-color: transparent;
		opacity: 0.6;
	}
	.r-url {
		margin: 0;
		font-size: 0.68rem;
		color: var(--muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.r-title {
		margin: 2px 0 0;
		font-size: 0.82rem;
		font-weight: 650;
		line-height: 1.4;
		color: var(--ga);
	}

	.chrome {
		display: flex;
		align-items: center;
		gap: 5px;
		padding: 8px 10px;
		border-bottom: 1px solid var(--line);
		background: var(--card);
	}
	.dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--line);
	}
	.addr {
		margin-left: 8px;
		flex: 1;
		min-width: 0;
		padding: 1px 10px;
		border-radius: 999px;
		background: var(--bg);
		font-size: 0.68rem;
		color: var(--muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.page {
		padding: 12px 16px 16px;
	}
	.code {
		display: block;
		height: 30px;
		margin-top: 10px;
		border-radius: 6px;
		background: var(--code-inline-bg);
	}

	/* ── 방문 전 → 방문 후 ── */
	.hop {
		grid-area: click;
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.hop-line {
		position: absolute;
		left: 8px;
		right: 8px;
		top: 50%;
		height: 2px;
		background: var(--ink-soft);
	}
	.hop-line::after {
		content: '';
		position: absolute;
		right: -2px;
		top: -4px;
		border: 5px solid transparent;
		border-left: 7px solid var(--ink-soft);
		border-right: 0;
	}
	.hop-label {
		position: relative;
		margin-top: -44px;
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--ink-soft);
		text-align: center;
		line-height: 1.3;
	}

	/* ── 아래로 내려가는 연결 ── */
	.drop {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 64px;
	}
	.drop::before {
		content: '';
		position: absolute;
		top: 6px;
		bottom: 6px;
		left: 50%;
		width: 0;
		border-left: 2px dashed var(--line);
	}
	.drop-sc {
		grid-area: dsc;
	}
	.drop-sc::before {
		border-left-color: color-mix(in srgb, var(--sc) 60%, transparent);
	}
	.drop-sc span {
		position: relative;
		padding: 2px 10px;
		font-size: 0.72rem;
		color: var(--sc);
		background: var(--card);
	}
	.drop-ga {
		grid-area: dga;
	}
	.drop-ga::before {
		border-left: 2px solid var(--ink-soft);
	}
	.gtm-pipe {
		position: relative;
		display: inline-flex;
		align-items: baseline;
		gap: 8px;
		padding: 5px 14px;
		border: 1.5px solid var(--ink);
		border-radius: 999px;
		background: var(--card);
		white-space: nowrap;
	}
	.gtm-pipe b {
		font-size: 0.82rem;
		color: var(--ink);
	}
	.gtm-pipe small {
		font-size: 0.72rem;
		color: var(--muted);
	}

	/* ── 도구 카드 ── */
	.tool {
		padding: 16px 16px 14px;
		border-radius: 12px;
		border: 1px solid var(--line);
		border-top: 4px solid var(--tone);
		background: var(--card);
	}
	.tool.sc {
		grid-area: sc;
		--tone: var(--sc);
	}
	.tool.ga {
		grid-area: ga;
		--tone: var(--ga);
	}
	.tool header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 6px;
	}
	.tool h4 {
		margin: 0;
		font-size: 1.05rem;
		color: var(--tone);
	}
	.badge {
		font-size: 0.68rem;
		padding: 1px 8px;
		border-radius: 999px;
		color: var(--tone);
		background: color-mix(in srgb, var(--tone) 12%, transparent);
	}
	.what {
		margin: 10px 0 0;
		font-size: 0.9rem;
		font-weight: 600;
		line-height: 1.5;
		color: var(--ink);
	}
	.tool dl {
		display: flex;
		gap: 8px;
		margin: 8px 0 0;
		font-size: 0.78rem;
	}
	.tool dt {
		color: var(--muted);
		white-space: nowrap;
	}
	.tool dd {
		margin: 0;
		color: var(--ink-soft);
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 5px;
		list-style: none;
		margin: 12px 0 0;
		padding: 0;
	}
	.chips li {
		margin: 0;
		font-size: 0.72rem;
		padding: 1px 8px;
		border-radius: 6px;
		border: 1px solid var(--line);
		color: var(--ink-soft);
	}

	/* ── SC ↔ GA4 연결 ── */
	.link {
		grid-area: link;
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.link-line {
		position: absolute;
		left: 0;
		right: 0;
		top: 50%;
		border-top: 2px dashed var(--muted);
		opacity: 0.6;
	}
	.link-label {
		position: relative;
		padding: 6px 4px;
		font-size: 0.7rem;
		line-height: 1.35;
		color: var(--muted);
		text-align: center;
		background: var(--card);
	}

	figcaption {
		margin-top: 0.6em;
		font-size: 0.85em;
		color: var(--muted);
		text-align: center;
	}

	/* ── 좁은 화면: 세로로 쌓기 ── */
	@media (max-width: 680px) {
		.board {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas:
				'before'
				'dsc'
				'sc'
				'click'
				'after'
				'dga'
				'ga'
				'link';
			padding: 16px;
		}
		.hop {
			min-height: 64px;
		}
		.hop-line {
			left: 50%;
			right: auto;
			top: 8px;
			bottom: 8px;
			width: 2px;
			height: auto;
		}
		.hop-line::after {
			right: auto;
			left: -4px;
			top: auto;
			bottom: -2px;
			border: 5px solid transparent;
			border-top: 7px solid var(--ink-soft);
			border-bottom: 0;
		}
		.hop-label {
			margin: 0 0 0 110px;
		}
		.link {
			margin-top: 14px;
		}
		.link-line {
			display: none;
		}
		.link-label br {
			display: none;
		}
		.link-label {
			padding: 6px 12px;
			border: 1px dashed var(--muted);
			border-radius: 8px;
			font-size: 0.75rem;
		}
	}
</style>
