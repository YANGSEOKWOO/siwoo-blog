---
/**
 * 요청 하나가 톰캣 → Filter → DispatcherServlet → Interceptor → Controller
 * → Service → Repository로 들어갔다가 거꾸로 나오는 과정을
 * 중첩 상자와 단계 버튼으로 보여주는 그림. 단계 내용은 steps prop으로 바꿀 수 있습니다.
 */
interface Step {
	box: 'tomcat' | 'filter' | 'ds' | 'ic' | 'ctrl' | 'svc' | 'repo';
	title: string;
	state: 'Running' | 'Blocked';
	dir: 'in' | 'out';
	db?: boolean;
}
interface Props {
	caption?: string;
	steps?: Step[];
}
const defaultSteps: Step[] = [
	{ box: 'tomcat', dir: 'in', state: 'Running', title: '워커 스레드가 깨어남' },
	{ box: 'filter', dir: 'in', state: 'Running', title: 'Filter 통과' },
	{ box: 'ds', dir: 'in', state: 'Running', title: 'DispatcherServlet이 Controller 찾기' },
	{ box: 'ic', dir: 'in', state: 'Running', title: 'Interceptor preHandle' },
	{ box: 'ctrl', dir: 'in', state: 'Running', title: 'Controller 실행' },
	{ box: 'svc', dir: 'in', state: 'Running', title: '트랜잭션 시작 → Service 실행' },
	{ box: 'repo', dir: 'in', state: 'Blocked', title: 'Repository가 SQL 전송 → 응답 대기', db: true },
	{ box: 'svc', dir: 'out', state: 'Running', title: 'DB 응답 도착 → 트랜잭션 커밋' },
	{ box: 'ds', dir: 'out', state: 'Running', title: '반환값을 JSON으로 변환' },
	{ box: 'ic', dir: 'out', state: 'Running', title: 'Interceptor afterCompletion' },
	{ box: 'filter', dir: 'out', state: 'Running', title: 'Filter 통과 (나올 때)' },
	{ box: 'tomcat', dir: 'out', state: 'Blocked', title: '응답 전송 → 스레드 풀로 돌아가 잠듦' },
];
const { caption, steps = defaultSteps } = Astro.props;
---

<figure class="rjourney" data-steps={JSON.stringify(steps)}>
	<div class="panel">
		<div class="nest">
			<div class="box" data-b="tomcat"><span class="bl">톰캣 워커 스레드</span>
				<div class="box" data-b="filter"><span class="bl">Filter</span>
					<div class="box" data-b="ds"><span class="bl">DispatcherServlet</span>
						<div class="box" data-b="ic"><span class="bl">Interceptor</span>
							<div class="box" data-b="ctrl"><span class="bl">Controller</span>
								<div class="box" data-b="svc"><span class="bl">Service</span>
									<div class="box" data-b="repo"><span class="bl">Repository</span>
										<div class="core"><span class="dir"></span><span class="db">DB</span></div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="side">
			<p class="meta"><span class="num"></span><span class="chip"></span></p>
			<p class="title"></p>
			<div class="ctrl">
				<button type="button" data-act="prev">이전</button>
				<button type="button" data-act="next" class="primary">다음</button>
				<button type="button" data-act="auto">자동 재생</button>
			</div>
			<ol class="list">
				{steps.map((s, i) => (
					<li><button type="button" data-i={i}><span class="n">{String(i + 1).padStart(2, '0')}</span>{s.title}</button></li>
				))}
			</ol>
		</div>
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
	type Step = { box: string; title: string; state: string; dir: string; db?: boolean };
	document.querySelectorAll<HTMLElement>('.rjourney').forEach((root) => {
		const steps: Step[] = JSON.parse(root.dataset.steps || '[]');
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const listBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.list button'));
		let cur = 0;
		let timer: number | undefined;

		function go(i: number) {
			cur = Math.max(0, Math.min(steps.length - 1, i));
			const s = steps[cur];
			const target = q<HTMLElement>(`.box[data-b="${s.box}"]`);
			root.querySelectorAll('.box').forEach((b) => {
				b.classList.toggle('on', b === target);
				b.classList.toggle('in', b !== target && b.contains(target));
			});
			q('.db').classList.toggle('on', !!s.db);
			q('.dir').textContent = s.db ? '스레드 잠듦 · DB 응답 대기' : s.dir === 'in' ? '→ 들어가는 중' : '← 나오는 중';
			q('.num').textContent = `${cur + 1} / ${steps.length} · ${s.dir === 'in' ? '들어감' : '나옴'}`;
			const chip = q<HTMLElement>('.chip');
			chip.textContent = s.state;
			chip.dataset.s = s.state;
			q('.title').textContent = s.title;
			listBtns.forEach((b, k) => {
				b.classList.toggle('cur', k === cur);
				b.classList.toggle('done', k < cur);
			});
			q<HTMLButtonElement>('[data-act="prev"]').disabled = cur === 0;
			q<HTMLButtonElement>('[data-act="next"]').disabled = cur === steps.length - 1;
		}
		function stop() {
			if (timer) window.clearInterval(timer);
			timer = undefined;
			q('[data-act="auto"]').textContent = '자동 재생';
		}
		root.addEventListener('click', (e) => {
			const btn = (e.target as HTMLElement).closest('button');
			if (!btn || !root.contains(btn)) return;
			const act = btn.dataset.act;
			if (btn.dataset.i !== undefined) { stop(); go(Number(btn.dataset.i)); }
			else if (act === 'prev') { stop(); go(cur - 1); }
			else if (act === 'next') { stop(); go(cur + 1); }
			else if (act === 'auto') {
				if (timer) return stop();
				if (cur === steps.length - 1) go(0);
				btn.textContent = '멈춤';
				timer = window.setInterval(() => (cur >= steps.length - 1 ? stop() : go(cur + 1)), 1600);
			}
		});
		go(0);
	});
</script>

<style>
	.rjourney {
		--req: #c27303;
		margin: 2.2em 0;
	}
	.panel {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		gap: 20px;
		padding: 20px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 14px;
	}
	.box {
		position: relative;
		border: 1.5px solid var(--line);
		border-radius: 8px;
		padding: 24px 8px 8px;
		transition: background 0.25s, border-color 0.25s;
	}
	.bl {
		position: absolute;
		top: 4px;
		left: 9px;
		font-size: 0.72rem;
		color: var(--muted);
	}
	.box.in { border-color: color-mix(in srgb, var(--req) 45%, var(--line)); }
	.box.on {
		border-color: var(--req);
		background: color-mix(in srgb, var(--req) 12%, transparent);
	}
	.box.on > .bl { color: var(--req); font-weight: 700; }
	.core {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 8px;
		min-height: 30px;
	}
	.dir { font-size: 0.75rem; color: var(--req); }
	.db {
		font-size: 0.75rem;
		border: 1.5px solid var(--line);
		border-radius: 10px / 6px;
		padding: 4px 10px;
	}
	.db.on { border-color: var(--muted); background: var(--accent-soft); }
	.side { display: grid; gap: 10px; align-content: start; min-width: 0; }
	.meta { margin: 0; display: flex; gap: 8px; align-items: center; font-size: 0.75rem; color: var(--muted); }
	.chip {
		border: 1px solid currentColor;
		border-radius: 999px;
		padding: 0 8px;
	}
	.chip[data-s='Running'] { color: var(--ok); }
	.chip[data-s='Blocked'] { color: var(--muted); }
	.title { margin: 0; font-weight: 700; font-size: 1.02rem; }
	.ctrl { display: flex; flex-wrap: wrap; gap: 6px; }
	.ctrl button {
		font: inherit;
		font-size: 0.85rem;
		padding: 5px 12px;
		border-radius: 6px;
		border: 1px solid var(--line);
		background: var(--surface);
		color: var(--ink);
		cursor: pointer;
	}
	.ctrl button.primary { background: var(--req); border-color: var(--req); color: #fff; }
	.ctrl button:disabled { opacity: 0.4; cursor: not-allowed; }
	.list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; }
	.list button {
		all: unset;
		box-sizing: border-box;
		width: 100%;
		cursor: pointer;
		display: flex;
		gap: 8px;
		padding: 3px 8px;
		border-radius: 5px;
		font-size: 0.82rem;
	}
	.list button:hover { background: var(--accent-soft); }
	.list button:focus-visible, .ctrl button:focus-visible { outline: 2px solid var(--req); outline-offset: 1px; }
	.list button.cur { background: color-mix(in srgb, var(--req) 14%, transparent); font-weight: 700; }
	.list button.done { color: var(--muted); }
	.n { font-size: 0.7rem; color: var(--muted); min-width: 1.6em; }
	figcaption { margin-top: 0.7em; text-align: center; font-size: 0.85rem; color: var(--muted); }
	@media (max-width: 720px) {
		.panel { grid-template-columns: minmax(0, 1fr); padding: 14px; }
		.box { padding: 22px 5px 5px; }
	}
	@media (prefers-reduced-motion: reduce) { .box { transition: none; } }
</style>
